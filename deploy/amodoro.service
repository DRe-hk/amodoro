[Unit]
Description=Amodoro
Documentation=https://github.com/tu-usuario/amodoro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amodoro
Group=amodoro
WorkingDirectory=/opt/amodoro

EnvironmentFile=-/etc/amodoro/env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
Environment=DB_PATH=/var/lib/amodoro/amodoro.db
Environment=UPLOADS_PATH=/var/lib/amodoro/uploads

ExecStart=/usr/bin/node /opt/amodoro/server.js

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# The database and uploaded assets are the product data.
StateDirectory=amodoro
ReadWritePaths=/var/lib/amodoro

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=amodoro

[Install]
WantedBy=multi-user.target
